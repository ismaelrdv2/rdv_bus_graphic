{
  "name": "rdv-bus",
  "private": true,
  "version": "0.1.0-alpha.9.3.1",
  "type": "module",
  "description": "RDV Bus Studio — editor de HUDs para vídeos de ônibus",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:build:linux": "tauri build --bundles appimage",
    "desktop:build:windows": "tauri build --bundles nsis"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-fs": "^2.7.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
