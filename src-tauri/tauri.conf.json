{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RDV Bus Studio - Animacoes TESTE",
  "version": "0.1.0-alpha.9.3.8",
  "identifier": "com.rdvbus.studio.animationtest",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RDV Bus Studio — Animações TESTE (Alpha 9.3.8)",
        "width": 1480,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 680,
        "backgroundColor": "#100b18",
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "Editor gráfico para vídeos de ônibus",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
